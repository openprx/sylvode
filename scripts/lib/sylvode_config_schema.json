{
  "comment": "The configuration keys the api, worker and mcp-server binaries accept (crates/platform/src/config/raw.rs; every section denies unknown keys). Read by scripts/start.sh --check-config. The platform test config::schema_tests compares this file with the Rust types and fails when either side gains or loses a key.",
  "sections": {
    "server": ["app_name", "bind_addr", "trusted_proxies", "public_url"],
    "email": ["enabled", "smtp_host", "smtp_port", "tls", "username", "password", "from", "ca_file", "digest_hour_utc"],
    "database": [
      "url",
      "max_connections",
      "min_connections",
      "connect_timeout_seconds",
      "idle_timeout_seconds",
      "acquire_timeout_seconds"
    ],
    "auth": [
      "jwt_secret",
      "access_ttl_seconds",
      "refresh_ttl_seconds",
      "allow_insecure_cookies",
      "rate_limit_scale"
    ],
    "logging": ["filter", "format", "output"],
    "storage": ["backend", "dir", "s3"],
    "storage.s3": ["endpoint", "bucket", "region", "access_key_id", "secret_access_key", "session_token"],
    "audit": ["operation_log_retention_days"],
    "api": ["max_change_hint_streams", "max_change_hint_streams_per_workspace"],
    "ai_tasks": [
      "processing_timeout_secs",
      "lease_extension_secs",
      "max_processing_secs",
      "max_chain_depth",
      "delivery_concurrency",
      "per_runner_concurrency",
      "lane_batch",
      "poll_interval_ms",
      "pool_idle_timeout_secs",
      "pool_max_idle_per_host",
      "tcp_keepalive_secs"
    ],
    "outbound": ["allowed_hosts", "allow_private"],
    "mcp": [
      "api_url",
      "bot_token",
      "workspace_id",
      "transport",
      "bind_addr",
      "oauth_issuer",
      "oauth_resource",
      "oauth_forward_secret",
      "tool_mode",
      "allow_write_call",
      "listen",
      "allowed_origins",
      "max_listen_streams"
    ],
    "flow": ["dispatch_max_attempts", "collab_allowed_origins", "conversion_reap_interval_secs", "body_asset_max_bytes", "incremental_window", "setup_cpu_budget_ms"],
    "oauth": [
      "issuer",
      "api_resource",
      "mcp_resource",
      "internal_forward_secret",
      "allow_insecure_loopback_issuer",
      "access_token_ttl_seconds",
      "refresh_token_idle_days",
      "grant_max_lifetime_days",
      "authorization_code_ttl_seconds",
      "max_active_grants_per_user_client",
      "event_feed_retention_days",
      "event_backfill_max_events",
      "event_backfill_max_age_hours",
      "max_streams_per_process"
    ],
    "inbound": [
      "enabled",
      "max_body_bytes",
      "signature_tolerance_secs",
      "auth_failures_per_minute_per_ip",
      "max_active_alert_tasks_per_workspace",
      "max_alerts_per_rule_per_hour",
      "event_retention_days",
      "followup_interval_secs"
    ],
    "packages": ["builtin_public_key", "builtin_dir"],
    "site": ["same_origin_trial", "cookie_insecure", "assets_dir", "mount_path"]
  },
  "retired": {}
}
