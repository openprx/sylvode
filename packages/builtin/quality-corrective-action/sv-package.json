      "kind": "form",
      "create_from": "contents/forms/root_cause_analysis.json"
    },
    "corrective_action": {
      "kind": "form",
      "create_from": "contents/forms/corrective_action.json"
    }
  },
  "files": {},
  "project": {
    "type_key": "custom_form",
    "workflow_states": [
      {
        "key": "detected",
