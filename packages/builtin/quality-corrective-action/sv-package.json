          "en": "Detected",
          "zh": "已发现"
        },
        "category": "unstarted",
        "initial": true
      },
      {
        "key": "root_cause",
        "name": {
          "en": "Root Cause",
          "zh": "根因分析"
        },
        "category": "active"
      },
      {
        "key": "action_plan",
        "name": {
          "en": "Action Plan",
          "zh": "措施计划"
        },
        "category": "active"
      },
      {
        "key": "recheck",
        "name": {
          "en": "Recheck",
          "zh": "复检"
        },
        "category": "active"
      },
      {
        "key": "closed",
        "name": {
          "en": "Closed",
          "zh": "已关闭"
        },
        "category": "completed"
      }
    ],
    "labels": [
      {
        "name": {
          "en": "defect",
          "zh": "缺陷"
        },
        "color": "#2563eb"
