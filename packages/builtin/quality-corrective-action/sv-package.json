      {
        "name": {
          "en": "root-cause",
          "zh": "根因"
        },
        "color": "#7c3aed"
      },
      {
        "name": {
          "en": "corrective-action",
          "zh": "纠正措施"
        },
        "color": "#dc2626"
      },
      {
        "name": {
          "en": "recheck",
          "zh": "复检"
        },
        "color": "#0891b2"
      }
