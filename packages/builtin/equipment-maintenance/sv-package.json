{
  "schema": "sv.package.v1",
  "kind": "form-template",
  "id": "sv/equipment-maintenance",
  "version": "1.0.0",
  "publisher": {
    "id": "sv",
    "key_id": "ed25519:00000000000000000000000000000000"
  },
  "sv": {
    "min": "0.6.0",
    "form_schema": "sv.form.schema.v2"
  },
  "summary": {
    "en": "Equipment, repair-order and inspection forms.",
    "zh": "设备、维修单和巡检记录表单。"
  },
  "license": "Apache-2.0",
  "binds": {
    "equipment": {
      "kind": "form",
      "create_from": "contents/forms/equipment.json"
    },
    "repair_order": {
      "kind": "form",
      "create_from": "contents/forms/repair_order.json"
    },
    "inspection_record": {
      "kind": "form",
      "create_from": "contents/forms/inspection_record.json"
    }
  },
  "files": {},
  "project": {
    "type_key": "custom_form",
    "workflow_states": [
      {
        "key": "reported",
        "name": {
          "en": "Reported",
          "zh": "已报修"
        },
        "category": "unstarted",
        "initial": true
      },
      {
        "key": "triage",
        "name": {
          "en": "Triage",
          "zh": "分诊"
        },
        "category": "active"
      },
      {
        "key": "repairing",
        "name": {
          "en": "Repairing",
          "zh": "维修中"
        },
        "category": "active"
      },
      {
        "key": "inspection",
        "name": {
          "en": "Inspection",
          "zh": "验收"
        },
        "category": "active"
      },
      {
        "key": "closed",
        "name": {
          "en": "Closed",
          "zh": "已关闭"
        },
        "category": "completed"
      }
    ],
    "labels": [
      {
        "name": {
          "en": "safety",
          "zh": "安全"
        },
        "color": "#2563eb"
      },
      {
        "name": {
          "en": "downtime",
          "zh": "停机"
        },
        "color": "#7c3aed"
      },
      {
        "name": {
          "en": "parts-needed",
          "zh": "需要备件"
        },
        "color": "#dc2626"
      },
      {
        "name": {
          "en": "inspection-needed",
          "zh": "需要巡检"
        },
        "color": "#0891b2"
      }
    ]
  }
}
