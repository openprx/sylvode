{
  "schema": "sv.package.v1",
  "kind": "form-template",
  "id": "sv/contract-review",
  "version": "1.0.0",
  "publisher": {
    "id": "sv",
    "key_id": "ed25519:00000000000000000000000000000000"
  },
  "sv": {
    "min": "0.6.0",
    "form_schema": "sv.form.schema.v2"
  },
  "summary": {
    "en": "Contract, risk-clause and approval-record forms.",
    "zh": "合同、风险条款和审批记录表单。"
  },
  "license": "Apache-2.0",
  "binds": {
    "contract": {
      "kind": "form",
      "create_from": "contents/forms/contract.json"
    },
    "risk_clause": {
      "kind": "form",
      "create_from": "contents/forms/risk_clause.json"
    },
    "approval_record": {
      "kind": "form",
      "create_from": "contents/forms/approval_record.json"
    }
  },
  "files": {},
  "project": {
    "type_key": "custom_form",
    "workflow_states": [
      {
        "key": "intake",
        "name": {
          "en": "Intake",
          "zh": "受理"
        },
        "category": "unstarted",
        "initial": true
      },
      {
        "key": "extract",
        "name": {
          "en": "Extract Terms",
          "zh": "条款提取"
        },
        "category": "active"
      },
      {
        "key": "risk_review",
        "name": {
          "en": "Risk Review",
          "zh": "风险审查"
        },
        "category": "active"
      },
      {
        "key": "approval",
        "name": {
          "en": "Approval",
          "zh": "审批"
        },
        "category": "active"
      },
      {
        "key": "signed",
        "name": {
          "en": "Signed",
          "zh": "已签署"
        },
        "category": "completed"
      }
    ],
    "labels": [
      {
        "name": {
          "en": "legal-risk",
          "zh": "法律风险"
        },
        "color": "#2563eb"
      },
      {
        "name": {
          "en": "commercial-risk",
          "zh": "商务风险"
        },
        "color": "#7c3aed"
      },
      {
        "name": {
          "en": "approval-needed",
          "zh": "需审批"
        },
        "color": "#dc2626"
      },
      {
        "name": {
          "en": "signed",
          "zh": "已签署"
        },
        "color": "#0891b2"
      }
    ]
  }
}
