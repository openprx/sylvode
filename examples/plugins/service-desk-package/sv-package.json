{
  "schema": "sv.package.v1",
  "kind": "app",
  "id": "qa/service-desk",
  "version": "1.0.0",
  "publisher": {"id": "qa", "key_id": "ed25519:00000000000000000000000000000000"},
  "sv": {"min": "0.6.0", "layout": "sv.layout.v1", "form_schema": "sv.form.schema.v2"},
  "wit": "sv:plugin@4.0.0",
  "summary": {"en": "Service desk: a requests form, a reference-code rule and request actions", "zh": "服务台：请求表单、参考编号规则和请求操作"},
  "license": "Apache-2.0",
  "binds": {
    "requests": {
      "kind": "form",
      "create_from": "contents/forms/requests.json",
      "requires_fields": {"title": "text", "reference": "text", "status": "text", "assignee": "text"}
    }
  },
  "requests": [
    {"id": "forms.records.read", "form": "$bind.requests"},
    {"id": "forms.records.update", "form": "$bind.requests"}
  ],
  "actions": [
    {"name": "assign_request", "world": "action", "component": "contents/components/service-desk-action.wasm", "label": {"en": "Assign request", "zh": "分配请求"}},
    {"name": "close_request", "world": "action", "component": "contents/components/service-desk-action.wasm", "label": {"en": "Close request", "zh": "关闭请求"}}
  ],
  "rules": [
    {"name": "reference_code", "world": "field-rule", "component": "contents/components/service-desk-rule.wasm",
     "stages": ["normalize", "validate"], "field_types": ["text"]}
  ],
  "messages": {"invalid_reference": {"en": "The reference code must be SD- and six digits", "zh": "参考编号必须是 SD- 加六位数字"}},
  "layouts": [
    {"key": "service.request.actions", "path": "contents/layouts/actions.json", "slots": ["form.record.actions"]}
  ],
  "pages": [],
  "depends": [],
  "files": {}
}
