# Build context of Dockerfile, Dockerfile.prebuilt and apps/webhook/Dockerfile (compose builds
# with context "."; apps/webhook is covered by apps/**). Only what the Dockerfiles copy is sent;
# everything else, including target/ apart from the five release binaries, .flow-gate/, uploads,
# generated configuration with secrets and .env, stays out.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!apps/**
!crates/**
!benches/**
!migrations/**
!spikes/collab-shared/**
!spikes/collab-loro/**
!spikes/collab-yrs-yjs/**
!target/release/api
!target/release/worker
!target/release/mcp-server
!target/release/sylvode
!target/release/collab-isolated-apply-worker
**/node_modules
**/target/debug
