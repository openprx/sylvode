# Build artifacts
/target
/node_modules
/frontend/build
/frontend/.svelte-kit
/frontend/node_modules

# Environment & secrets
.env
.env.*
!.env.example
/frontend/.env
!/frontend/.env.example

# Flow benchmark output (GitHub Actions uploads this; it is not source)
/flow-bench-results/

# Logs (project-level and frontend dev logs)
*.log
/log/
/frontend/log/
/playwright-report/
/test-results/

# User uploads (runtime data)
/uploads/

# Database dumps written by scripts/backup-db.sh
/backups/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Internal dev tools & notes (not for open source)
/.dispatch_link
/AGENTS.md
/PHASE4_EXECUTION_SUMMARY.txt
/PHASE5_SUMMARY.txt
/docs/prd/

# Test scripts (internal)
/test-mcp-server.sh

# Package manager locks (users generate their own)
/frontend/bun.lock

# Database files
*.db
*.sqlite
.brv/

# Generated runtime configuration; contains the signing key, the database password and the MCP bot
# token. scripts/start.sh writes these `sylvode.*` names.
/config/sylvode.compose*.toml
/config/sylvode.toml

# Claude Code session state, including agent worktrees that are git repos of their own
.claude/

# Python bytecode caches: regenerated on every run, never a build input.
__pycache__/
*.py[cod]

# Local deployment descriptor: carries a gate account password and machine paths
deploy/flow-deployed-websocket.json

# Local release-gate evidence; authoritative contracts live in the separate read-only checkout.
/.flow-gate/

# The e2e stand-in CLI must never leave files in the tree; ignored as a second line of defence.
standin.*
