# Sylvode — docker-compose environment.
#
# Application settings, including all API and worker credentials, come from the TOML file
# named with `--config`. See config/sylvode.example.toml for the annotated reference, and
# `bash scripts/start.sh` to generate a working pair of files for the compose stack:
#
#   config/sylvode.compose.toml      api + worker  (server, database, auth, logging, storage, migrations, outbound, flow)
#   config/sylvode.compose.mcp.toml  mcp-server    (logging, mcp)
#
# Compose also passes two optional rollout switches to the API. SV_FORM_PLUGIN_PACKAGES_ENABLED
# enables personal plugin libraries and protocol 3 form plugin packages;
# SV_FORM_PLUGIN_EXTENSIONS_ENABLED enables the protocol 3 package extensions. Both default to 0 and
# the Plugin Creator needs both.
#SV_FORM_PLUGIN_PACKAGES_ENABLED=0
#SV_FORM_PLUGIN_EXTENSIONS_ENABLED=0

# PostgreSQL bootstrap. The postgres:18 image runs initdb from this on the first start of the
# pgdata volume, and never again. It must match the password inside `url` under [database] in
# config/sylvode.compose.toml, or every query fails to authenticate.
# scripts/start.sh generates a local value on first run and keeps the two in step.
#POSTGRES_PASSWORD=replace_with_postgres_password

# Host interface the compose stack publishes its ports on. Defaults to 127.0.0.1 when unset;
# use 0.0.0.0 only for trusted local network testing.
#SYLVODE_BIND_HOST=127.0.0.1

# Published host ports. docker-compose.yml and scripts/start.sh default to the values shown;
# uncomment a line to change one.
#SYLVODE_API_PORT=8081
#SYLVODE_FRONTEND_PORT=3000
#SYLVODE_MCP_PORT=8090
#SYLVODE_RUNNER_PORT=9090
#SYLVODE_FRONTEND_DOCKERFILE=Dockerfile

# Optional Sylvode runner, enabled with the `connectors` compose profile. The config file is
# mounted at /etc/sylvode-runner/config.toml inside the container. Without an image of the default
# name present, compose builds it from apps/runner. To run a published image instead, pin one such
# as ghcr.io/openprx/sylvode-runner:<tag>. Prefer a version tag to :latest.
#SYLVODE_RUNNER_IMAGE=ghcr.io/openprx/sylvode-runner:latest
#SYLVODE_RUNNER_CONFIG=./config/sylvode-runner.example.toml

# Runtime base image used by Dockerfile.prebuilt. The binaries are compiled on the host, so this
# image must ship a glibc at least as new as the host's.
# scripts/start.sh fills this in automatically on Debian hosts.
#SYLVODE_RUNTIME_BASE=debian:bookworm-slim
