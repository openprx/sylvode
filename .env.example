# Sylvode — docker-compose environment.
#
# APPLICATION CONFIGURATION IS NOT HERE. The api, worker and mcp-server binaries read no
# environment variables at all; every setting they use comes from a TOML configuration file
# named with `--config`. See config/sylvode.example.toml for the annotated reference, and
# `bash scripts/start.sh` to generate a working pair of files for the compose stack:
#
#   config/sylvode.compose.toml      api + worker  (database, auth, storage, outbound, connectors)
#   config/sylvode.compose.mcp.toml  mcp-server    (logging, mcp)
#
# Everything below is consumed by docker-compose's own ${...} interpolation, or by the postgres
# image, which configures itself from the environment. Nothing here reaches Sylvode's own code.

# PostgreSQL bootstrap. The postgres:16 image runs initdb from this on the first start of the
# pgdata volume, and never again. It must match the password inside `url` under [database] in
# config/sylvode.compose.toml, or every query fails to authenticate.
# scripts/start.sh generates a local value on first run and keeps the two in step.
#POSTGRES_PASSWORD=replace_with_postgres_password

# Host interface the compose stack publishes its ports on. Defaults to 127.0.0.1 when unset;
# use 0.0.0.0 only for trusted local network testing.
#SYLVODE_BIND_HOST=127.0.0.1

# Published host ports. docker-compose.yml and scripts/start.sh default to the values shown;
# uncomment a line to change one. They stay commented so that a legacy compose variable set in
# the environment is not contradicted by a preset canonical value.
#SYLVODE_API_PORT=8081
#SYLVODE_FRONTEND_PORT=3000
#SYLVODE_MCP_PORT=8090
#SYLVODE_WEBHOOK_PORT=9090
#SYLVODE_FRONTEND_DOCKERFILE=Dockerfile

# Frontend API endpoint, baked in at build time. For local frontend development, point the
# browser at the compose API host port; the production frontend image proxies /api same-origin.
VITE_API_BASE_URL=http://localhost:8081

# Optional Sylvode Webhook receiver, enabled with the `connectors` compose profile. The config
# file is mounted at /etc/sylvode-webhook/config.toml inside the container. The default image
# name exists only from the first Sylvode Webhook release after 0.3.3 onward; until then pin a
# published image such as ghcr.io/openprx/openpr-webhook:<tag> (0.3.3 and earlier also need the
# compose command overridden to /app/openpr-webhook). Prefer a version tag to :latest.
#SYLVODE_WEBHOOK_IMAGE=ghcr.io/openprx/sylvode-webhook:latest
#SYLVODE_WEBHOOK_CONFIG=./config/sylvode-webhook.example.toml

# Runtime base image used by Dockerfile.prebuilt. The binaries are compiled on the host, so this
# image must ship a glibc at least as new as the host's.
# scripts/start.sh fills this in automatically on Debian hosts.
#SYLVODE_RUNTIME_BASE=debian:bookworm-slim

# Deprecated compatibility aliases remain accepted: OPENPR_BIND_HOST, OPENPR_API_PORT,
# OPENPR_FRONTEND_PORT, MCP_SERVER_PORT, OPENPR_WEBHOOK_PORT, OPENPR_WEBHOOK_IMAGE,
# OPENPR_WEBHOOK_CONFIG, OPENPR_FRONTEND_DOCKERFILE and OPENPR_RUNTIME_BASE. scripts/start.sh
# prints one deprecation warning per alias it reads; they are not removed before Sylvode v2.0.
# Do not define both names with different values; scripts/start.sh rejects an ambiguous
# deployment instead of choosing silently.
